# ==============================================================================
# FLOWMIND: AUTONOMOUS MULTI-AGENT ARCHITECTURE & DELIBERATION ENGINE
# PRODUCTION CONFIGURATION ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure your production credentials.
# Command: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)

# ------------------------------------------------------------------------------
# 1. LLM REASONING ENGINE & MODEL CARRIERS
# ------------------------------------------------------------------------------
# Model provider options:
#   - simulated : Zero-credential offline determinism for testing and CI
#   - gemma     : Google Gemma 3B open weights (Local Ollama / vLLM / SGLang / AI Studio)
#   - anthropic : Claude 3.5 Sonnet / Haiku with 1-hour KV-cache breakpoint
#   - openai    : GPT-4o / o1 reasoning carrier
#   - gemini    : Google Gemini 1.5 Pro / Flash carrier
#   - sglang    : Local / self-hosted SGLang RadixAttention cluster
#   - vllm      : Local / self-hosted vLLM high-throughput endpoint
FLOWMIND_MODEL_PROVIDER=simulated

# Google Gemma 3B Model Carrier (Local via Ollama/vLLM/SGLang or Cloud via Google AI Studio)
GEMMA_MODEL=gemma:3b
GEMMA_ENDPOINT=http://localhost:11434/v1
# GEMMA_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude API Key (Required if FLOWMIND_MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (Required if FLOWMIND_MODEL_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key (Required if FLOWMIND_MODEL_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# Self-Hosted SGLang RadixAttention Cluster (Required if FLOWMIND_MODEL_PROVIDER=sglang)
SGLANG_ENDPOINT=http://localhost:30000/v1

# Self-Hosted vLLM Server Endpoint (Required if FLOWMIND_MODEL_PROVIDER=vllm)
VLLM_ENDPOINT=http://localhost:8000/v1

# ------------------------------------------------------------------------------
# 2. DISTRIBUTED ASYMMETRIC STATE BUS & CAS STORAGE
# ------------------------------------------------------------------------------
# State Bus backend options:
#   - in_memory : Low-latency in-process single-instance thread-safe storage
#   - redis     : Distributed CAS fencing with Redis key-value storage
#   - nats      : Asymmetric NATS JetStream Key-Value ledger with RFC 6902 patching
FLOWMIND_STATE_BUS_BACKEND=in_memory

# Redis Connection URL (Used when FLOWMIND_STATE_BUS_BACKEND=redis)
FLOWMIND_REDIS_URL=redis://localhost:6379/0

# NATS JetStream Server Connection URL (Used when FLOWMIND_STATE_BUS_BACKEND=nats)
FLOWMIND_NATS_URL=nats://localhost:4222

# NATS KV Bucket Name for FlowMind State Ledger
FLOWMIND_NATS_BUCKET=flowmind_state_bus

# ------------------------------------------------------------------------------
# 3. CODE EXECUTION SANDBOX & BLAST-RADIUS CONTAINMENT
# ------------------------------------------------------------------------------
# Sandbox provider options:
#   - local             : Safe directory-confined AST validation & isolated workspace
#   - docker            : Containerized isolated runtime environment
#   - firecracker_vsock : Ultra-low-latency microVM isolation via AF_VSOCK Unix socket
FLOWMIND_SANDBOX_PROVIDER=local

# Docker Container Base Image (Used when FLOWMIND_SANDBOX_PROVIDER=docker)
FLOWMIND_DOCKER_IMAGE=python:3.12-slim

# Firecracker MicroVM Vsock Port (Used when FLOWMIND_SANDBOX_PROVIDER=firecracker_vsock)
FLOWMIND_VSOCK_PORT=1024

# ------------------------------------------------------------------------------
# 4. A2A BENCH ROTATION, PROMPT CACHE & REFLEX TIMEOUTS
# ------------------------------------------------------------------------------
# Prompt Cache Breakpoint TTL (Seconds): Default 3600 (1 hour for Anthropic cache tiers)
FLOWMIND_CACHE_TTL_SECONDS=3600

# Maximum steps before mandatory roster fatigue evaluation & bench substitution
FLOWMIND_MAX_STINT_STEPS=15

# ------------------------------------------------------------------------------
# 5. COGNITIVE BRAIN & MODEL EVOLUTION LEDGER
# ------------------------------------------------------------------------------
# Path to persistent Cognitive Brain JSON knowledge store.
# Defaults to ~/.flowmind/brain.json if left commented or blank.
# FLOWMIND_BRAIN_PATH=/path/to/custom/brain.json

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY, TELEMETRY & COACH REFLEX METRICS
# ------------------------------------------------------------------------------
# Telemetry sink options:
#   - local         : Internal memory buffer / Rich terminal logs
#   - opentelemetry : Export traces & spans to OpenTelemetry Collector
#   - prometheus    : Expose metrics endpoint for Prometheus scraping
FLOWMIND_TELEMETRY_SINK=local

# OpenTelemetry OTLP Exporter Endpoint (Used when FLOWMIND_TELEMETRY_SINK=opentelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Prometheus Metrics Scrape Port (Used when FLOWMIND_TELEMETRY_SINK=prometheus)
PROMETHEUS_METRICS_PORT=9090

# ------------------------------------------------------------------------------
# 7. REST API & STREAMING SERVER
# ------------------------------------------------------------------------------
# Server host bind address (Use 0.0.0.0 for Docker containers, 127.0.0.1 for local host)
FLOWMIND_SERVER_HOST=127.0.0.1

# Server port
FLOWMIND_SERVER_PORT=8000

# Allowed CORS Origins (comma-separated, or * for all)
FLOWMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 8. GITHUB INTEGRATION & CI/CD VERIFICATION GATING
# ------------------------------------------------------------------------------
# GitHub Personal Access Token or Actions GITHUB_TOKEN
# Required for posting automated architectural scorecard comments on Pull Requests.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target repository in 'owner/repo' format (automatically populated in GitHub Actions)
# GITHUB_REPOSITORY=owner/repository

# Target git reference (e.g., refs/pull/42/merge or main)
# GITHUB_REF=refs/heads/main
